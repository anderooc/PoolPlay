# Copy to .env.local and fill in. Only EXPO_PUBLIC_* vars reach the app bundle.
#
# These two are the same values as the web app's NEXT_PUBLIC_SUPABASE_* pair.
# The anon key is safe to ship: the database revokes table privileges from the
# anon and authenticated roles, so it grants sign-in and nothing else.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the brackt API lives. Defaults to http://localhost:3000 (rewritten to
# 10.0.2.2 on the Android emulator). Set a LAN address to test on a physical
# device, e.g. http://192.168.1.5:3000
EXPO_PUBLIC_API_BASE_URL=
